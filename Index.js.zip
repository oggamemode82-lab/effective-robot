const canvas = document.getElementById("c");const ctx = canvas.getContext("2d");canvas.width = 260;canvas.height = 360;let px = 110, py = 300, ps = 30;let items = [];let score = 0;let running = true;const scoreEl = document.getElementById("score");/* TOUCH + MOUSE MOVE */canvas.addEventListener("mousemove", move);canvas.addEventListener("touchmove", move, {passive:false});function move(e){  e.preventDefault();  let x = e.touches ? e.touches[0].clientX : e.clientX;  let r = canvas.getBoundingClientRect();  px = (x - r.left) * (canvas.width / r.width) - ps/2;  px = Math.max(0, Math.min(px, canvas.width - ps));}/* RESET GAME */function resetGame(){  score = 0;  items = [];  running = true;  scoreEl.innerText = score;  loop();}/* EXIT GAME */function exitGame(){  running = false;  alert("Exit Game");}/* GAME LOOP */function loop(){  if(!running) return;  ctx.clearRect(0,0,canvas.width,canvas.height);  /* BLUE PLAYER */  ctx.fillStyle = "#00f2fe";  ctx.fillRect(px, py, ps, ps);  /* SPAWN BLOCKS */  if(Math.random() < 0.04){    items.push({      x: Math.random()*(canvas.width-20),      y: -20,      s: 20,      t: Math.random()<0.7 ? "coin" : "red"    });  }  for(let i=items.length-1;i>=0;i--){    let o = items[i];    o.y += 3;    ctx.fillStyle = o.t==="coin" ? "#ff0" : "#f00";    ctx.fillRect(o.x,o.y,o.s,o.s);    /* COLLISION */    if(o.x<px+ps && o.x+o.s>px && o.y<py+ps && o.y+o.s>py){      if(o.t==="coin"){        score++;        scoreEl.innerText = score;        items.splice(i,1);      }else{        alert("GAME OVER");        running = false;        return;      }    }    if(o.y > canvas.height) items.splice(i,1);  }  requestAnimationFrame(loop);}loop();