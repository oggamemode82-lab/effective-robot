body,html{  margin:0;  padding:0;  background:#000;  color:#fff;  font-family:Arial;  overflow:hidden;}.page{  display:flex;  flex-direction:column;  align-items:center;}canvas{  width:260px;  height:360px;  background:#050505;  border:4px solid #00f2fe;  border-radius:12px;  touch-action:none;}/* SMALL EXIT BUTTON (LEFT) */#exitBtn{  position:absolute;  top:10px;  left:10px;  font-size:12px;  padding:5px 8px;  border-radius:50%;  border:none;  background:#ff0040;  color:#fff;  cursor:pointer;}/* SMALL RESET BUTTON (RIGHT) */#resetBtn{  position:absolute;  top:10px;  right:10px;  font-size:12px;  padding:5px 8px;  border-radius:50%;  border:none;  background:#00f2fe;  color:#000;  cursor:pointer;}#scoreBox{  margin-top:45px;  font-size:14px;}footer{  font-size:11px;  margin-top:6px;  color:#0ff;}